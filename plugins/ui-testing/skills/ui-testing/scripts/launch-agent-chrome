#!/usr/bin/env node
// Usage: launch-agent-chrome [--proxy PORT] [chrome args...]
// Without --proxy, starts the shared agent Chrome on port 9222.
// With --proxy, starts a Chrome for this Claude Code session only that proxies through
// 127.0.0.1:PORT. agent-chrome-mcp switches this session's playwright-cdp tools to it.

import { spawn, spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { setTimeout as sleep } from "node:timers/promises";

const CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
const SHARED_CDP_PORT = 9222;
const SHARED_PROFILE = path.join(os.homedir(), ".chrome-agent");
const sessionsDir = path.join(os.homedir(), ".chrome-agent-sessions");
const claudePid = process.env.CLAUDE_PID;
const stateFile = path.join(sessionsDir, `${claudePid}.json`);

let proxyPort;
const chromeArgs = [];
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === "--proxy") {
    proxyPort = argv[++i];
  } else if (argv[i].startsWith("--proxy=")) {
    proxyPort = argv[i].slice("--proxy=".length);
  } else {
    chromeArgs.push(argv[i]);
  }
}

function fail(message) {
  console.error(`launch-agent-chrome: ${message}`);
  process.exit(1);
}

function isAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function profileInUse(dir) {
  try {
    const owner = fs.readlinkSync(path.join(dir, "SingletonLock"));
    return isAlive(Number(owner.split("-").pop()));
  } catch {
    return false;
  }
}

// Chrome offers "Restore pages?" after a kill it can't catch, like Claude Code's SIGKILL on task stop.
function markCleanExit(profile) {
  const prefsFile = path.join(profile, "Default", "Preferences");
  try {
    const prefs = JSON.parse(fs.readFileSync(prefsFile, "utf8"));
    prefs.profile.exit_type = "Normal";
    fs.writeFileSync(prefsFile, JSON.stringify(prefs));
  } catch {}
}

// Returns the shared profile if no Chrome holds it, else an instant APFS clone at cloneDir.
function pickProfile(cloneDir) {
  const picked = pickProfileDir(cloneDir);
  markCleanExit(picked.profile);
  console.error(`launch-agent-chrome: profile directory is ${picked.profile}`);
  return picked;
}

function pickProfileDir(cloneDir) {
  if (!profileInUse(SHARED_PROFILE)) {
    // A stale port file would make us connect before Chrome writes the new one.
    fs.rmSync(path.join(SHARED_PROFILE, "DevToolsActivePort"), { force: true });
    return { profile: SHARED_PROFILE, cloned: false };
  }
  fs.mkdirSync(sessionsDir, { recursive: true });
  fs.rmSync(cloneDir, { recursive: true, force: true });
  const clone = spawnSync("cp", ["-cR", SHARED_PROFILE, cloneDir], {
    stdio: "inherit",
  });
  if (clone.status !== 0) fail("could not copy the shared profile");
  for (const name of fs.readdirSync(cloneDir)) {
    if (name.startsWith("Singleton") || name === "DevToolsActivePort") {
      fs.rmSync(path.join(cloneDir, name), { force: true });
    }
  }
  return { profile: cloneDir, cloned: true };
}

function readState() {
  try {
    return JSON.parse(fs.readFileSync(stateFile, "utf8"));
  } catch {
    return undefined;
  }
}

function forwardSignals(child) {
  for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
    process.on(signal, () => child.kill(signal));
  }
}

if (proxyPort === "") fail("--proxy needs a port");

// Retire this session's previous proxied Chrome so the tools fall back to, or swap to, the new one.
const oldState = claudePid && readState();
if (oldState) {
  try {
    process.kill(oldState.chromePid);
  } catch {}
  while (isAlive(oldState.chromePid)) await sleep(100);
  if (oldState.profile) {
    fs.rmSync(oldState.profile, { recursive: true, force: true });
  }
  fs.rmSync(stateFile, { force: true });
}

if (proxyPort === undefined) {
  try {
    await fetch(`http://127.0.0.1:${SHARED_CDP_PORT}/json/version`);
    process.exit(0);
  } catch {}
  const { profile, cloned } = pickProfile(
    path.join(sessionsDir, `shared-${process.pid}`),
  );
  const child = spawn(
    CHROME,
    [
      `--user-data-dir=${profile}`,
      `--remote-debugging-port=${SHARED_CDP_PORT}`,
      ...chromeArgs,
    ],
    { stdio: "inherit" },
  );
  forwardSignals(child);
  child.on("exit", (code) => {
    if (cloned) fs.rmSync(profile, { recursive: true, force: true });
    process.exit(code ?? 1);
  });
} else {
  if (!claudePid) {
    fail("--proxy must run from a Claude Code Bash tool (CLAUDE_PID is unset)");
  }

  fs.mkdirSync(sessionsDir, { recursive: true });
  const { profile, cloned } = pickProfile(path.join(sessionsDir, claudePid));
  const removeClone = () => {
    if (cloned) fs.rmSync(profile, { recursive: true, force: true });
  };

  const chrome = spawn(
    CHROME,
    [
      `--user-data-dir=${profile}`,
      "--remote-debugging-port=0",
      `--proxy-server=http://127.0.0.1:${proxyPort}`,
      "--no-first-run",
      "--no-default-browser-check",
      ...chromeArgs,
    ],
    { stdio: "ignore" },
  );

  let exitCode;
  const chromeExited = new Promise((resolve) =>
    chrome.on("exit", (code, signal) => {
      exitCode = code ?? signal;
      resolve();
    }),
  );

  // Waits for Chrome to exit first, since it keeps writing to the profile while shutting down.
  async function cleanup(code) {
    chrome.kill();
    await chromeExited;
    // Only clean up if a newer launch hasn't replaced this Chrome.
    if (readState()?.chromePid === chrome.pid) {
      removeClone();
      fs.rmSync(stateFile, { force: true });
    }
    process.exit(code);
  }

  for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
    process.on(signal, () => cleanup(1));
  }

  const portFile = path.join(profile, "DevToolsActivePort");
  const portTimeoutMs = 60_000;
  const deadline = Date.now() + portTimeoutMs;
  let cdpPort;
  while (!cdpPort && exitCode === undefined && Date.now() < deadline) {
    try {
      cdpPort = Number(fs.readFileSync(portFile, "utf8").split("\n")[0]);
    } catch {}
    if (!cdpPort) await sleep(100);
  }
  if (!cdpPort) {
    const reason =
      exitCode === undefined
        ? `within ${portTimeoutMs / 1000}s`
        : `before exiting (${exitCode})`;
    chrome.kill();
    await chromeExited;
    removeClone();
    fail(`Chrome did not open a debugging port ${reason}`);
  }

  // `profile` is set only for a clone, since whoever reads the state deletes it.
  fs.writeFileSync(
    stateFile,
    JSON.stringify({
      cdpPort,
      chromePid: chrome.pid,
      ...(cloned && { profile }),
    }),
  );
  console.log(
    `Chrome for this session is up on CDP port ${cdpPort}, proxied through 127.0.0.1:${proxyPort}`,
  );

  await chromeExited;
  await cleanup(0);
}
