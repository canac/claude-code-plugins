#!/usr/bin/env node
// Runs the Playwright MCP against this session's CDP forwarder.
// Usage: agent-chrome-mcp [playwright-mcp args...]

import { spawn } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { readState, startForwarder, stateFile } from "./cdp-forwarder.mjs";

// This server owns the session's Chrome, so it stops it when Claude Code exits.
function cleanup() {
  const { chromePid, profile } = readState();
  if (chromePid) {
    try {
      process.kill(chromePid);
    } catch {}
  }
  if (profile) fs.rmSync(profile, { recursive: true, force: true });
  fs.rmSync(stateFile, { force: true });
}

const { endpoint } = await startForwarder();
const child = spawn(
  "npx",
  [
    "--yes",
    "@playwright/mcp@latest",
    `--cdp-endpoint=${endpoint}`,
    ...process.argv.slice(2),
  ],
  {
    stdio: "inherit",
    // Keeps npx from enforcing the project's devEngines, e.g. a pnpm-only package.json.
    cwd: os.homedir(),
    env: {
      PLAYWRIGHT_MCP_OUTPUT_DIR: path.join(os.tmpdir(), "playwright-mcp"),
      ...process.env,
    },
  },
);
for (const signal of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(signal, () => child.kill(signal));
}
child.on("exit", (code) => {
  cleanup();
  process.exit(code ?? 1);
});
